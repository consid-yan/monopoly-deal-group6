<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane prefHeight="640.0" prefWidth="960.0"
           styleClass="result-screen-root"
           xmlns="http://javafx.com/javafx/25.0.2"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ie.ucd.bdic.group6.ui.ResultUI">
    <StackPane mouseTransparent="true" styleClass="menu-bg-pattern"/>

    <Label mouseTransparent="true" styleClass="menu-card-suit" text="&#9670;" StackPane.alignment="TOP_LEFT">
        <StackPane.margin>
            <Insets left="-10.0" top="-24.0"/>
        </StackPane.margin>
    </Label>
    <Label mouseTransparent="true" rotate="180.0" styleClass="menu-card-suit" text="&#9670;" StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets bottom="-24.0" right="-10.0"/>
        </StackPane.margin>
    </Label>

    <VBox alignment="CENTER" maxWidth="760.0" spacing="12.0" styleClass="result-content">
        <padding>
            <Insets bottom="24.0" left="30.0" right="30.0" top="20.0"/>
        </padding>

        <Label styleClass="result-brand-title" text="Monopoly Deal">
            <font>
                <Font name="Georgia Bold" size="28.0"/>
            </font>
        </Label>

        <StackPane maxHeight="68.0" maxWidth="68.0" styleClass="result-crown-medal">
            <FontIcon iconLiteral="bxs-crown" styleClass="result-crown-icon"/>
        </StackPane>

        <Label styleClass="result-eyebrow" text="MATCH COMPLETE"/>
        <Label fx:id="winnerNameLabel" maxWidth="Infinity" styleClass="result-winner-name" text="Winner"/>
        <Label fx:id="victoryReasonLabel" alignment="CENTER" maxWidth="620.0" styleClass="result-victory-reason"
               text="Completed 3 full property sets." textAlignment="CENTER" wrapText="true"/>

        <HBox alignment="CENTER" maxWidth="620.0" spacing="10.0" styleClass="result-stats-row">
            <VBox alignment="CENTER" maxWidth="Infinity" spacing="2.0" styleClass="result-stat-card" HBox.hgrow="ALWAYS">
                <Label fx:id="completedSetsLabel" styleClass="result-stat-value" text="3"/>
                <Label styleClass="result-stat-caption" text="FULL SETS"/>
            </VBox>
            <VBox alignment="CENTER" maxWidth="Infinity" spacing="2.0" styleClass="result-stat-card" HBox.hgrow="ALWAYS">
                <Label fx:id="bankValueLabel" styleClass="result-stat-value" text="25M"/>
                <Label styleClass="result-stat-caption" text="BANK VALUE"/>
            </VBox>
            <VBox alignment="CENTER" maxWidth="Infinity" spacing="2.0" styleClass="result-stat-card" HBox.hgrow="ALWAYS">
                <Label fx:id="finalRankLabel" styleClass="result-stat-value" text="1st"/>
                <Label styleClass="result-stat-caption" text="FINAL RANK"/>
            </VBox>
        </HBox>

        <VBox maxWidth="620.0" spacing="7.0" styleClass="result-standings-panel">
            <HBox alignment="CENTER_LEFT">
                <Label styleClass="result-section-title" text="Final Standings"/>
            </HBox>
            <ListView fx:id="standingsList" focusTraversable="false" maxHeight="210.0" minHeight="104.0"
                      prefHeight="190.0" styleClass="result-standings-list">
                <placeholder>
                    <Label styleClass="result-empty-label" text="No standings available"/>
                </placeholder>
            </ListView>
        </VBox>

        <HBox alignment="CENTER" spacing="10.0" styleClass="result-actions">
            <Button graphicTextGap="9.0" mnemonicParsing="false" onAction="#backToMenu"
                    prefHeight="42.0" prefWidth="154.0" styleClass="menu-outline-button" text="Main Menu">
                <graphic>
                    <FontIcon iconLiteral="bx-home" styleClass="menu-icon-outline"/>
                </graphic>
            </Button>
            <Button graphicTextGap="9.0" mnemonicParsing="false" onAction="#playAgain"
                    prefHeight="42.0" prefWidth="154.0" styleClass="menu-primary-button" text="Play Again">
                <graphic>
                    <FontIcon iconLiteral="bx-reset" styleClass="menu-icon-primary"/>
                </graphic>
            </Button>
            <Button graphicTextGap="9.0" mnemonicParsing="false" onAction="#exitApplication"
                    prefHeight="42.0" prefWidth="126.0" styleClass="menu-danger-button" text="Exit">
                <graphic>
                    <FontIcon iconLiteral="bx-exit" styleClass="menu-icon-danger"/>
                </graphic>
            </Button>
        </HBox>
    </VBox>
</StackPane>
