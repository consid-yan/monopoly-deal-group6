<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.control.TitledPane?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>

<BorderPane prefHeight="640.0" prefWidth="960.0"
            styleClass="menu-root root-screen result-screen"
            stylesheets="@../css/style.css"
            xmlns="http://javafx.com/javafx/25.0.2"
            xmlns:fx="http://javafx.com/fxml/1"
            fx:controller="ie.ucd.bdic.group6.ui.ResultUI">
    <top>
        <VBox alignment="CENTER_LEFT" spacing="8.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="18.0" left="48.0" right="48.0" top="36.0"/>
            </padding>
            <Label styleClass="menu-title title-banner" text="Game Over">
                <font>
                    <Font name="System Bold" size="38.0"/>
                </font>
            </Label>
            <Label styleClass="menu-subtitle" text="Final Monopoly Deal result and player summary" wrapText="true">
                <font>
                    <Font size="15.0"/>
                </font>
            </Label>
        </VBox>
    </top>
    <center>
        <VBox spacing="18.0" BorderPane.alignment="CENTER">
            <padding>
                <Insets bottom="28.0" left="48.0" right="48.0" top="8.0"/>
            </padding>
            <GridPane hgap="18.0" vgap="12.0">
                <columnConstraints>
                    <ColumnConstraints minWidth="160.0" prefWidth="190.0"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="260.0"/>
                    <ColumnConstraints minWidth="160.0" prefWidth="190.0"/>
                    <ColumnConstraints hgrow="ALWAYS" minWidth="260.0"/>
                </columnConstraints>
                <Label styleClass="winner-label" text="Winner" GridPane.columnIndex="0" GridPane.rowIndex="0">
                    <font>
                        <Font name="System Bold" size="16.0"/>
                    </font>
                </Label>
                <TextField editable="false" promptText="Winner" styleClass="winner-field" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                <Label text="Completed Property Sets" GridPane.columnIndex="2" GridPane.rowIndex="0">
                    <font>
                        <Font name="System Bold" size="16.0"/>
                    </font>
                </Label>
                <TextField editable="false" promptText="Completed Property Sets" GridPane.columnIndex="3" GridPane.rowIndex="0"/>
                <Label text="Win Condition" GridPane.columnIndex="0" GridPane.rowIndex="1">
                    <font>
                        <Font name="System Bold" size="16.0"/>
                    </font>
                </Label>
                <TextField editable="false" text="Completed 3 full property sets" GridPane.columnIndex="1" GridPane.columnSpan="3" GridPane.rowIndex="1"/>
            </GridPane>
            <Separator/>
            <HBox spacing="20.0">
                <TitledPane animated="false" collapsible="false" prefHeight="260.0" text="Player Summary"
                            HBox.hgrow="ALWAYS">
                    <ListView prefHeight="230.0" prefWidth="420.0">
                        <placeholder>
                            <Label text="Game Summary"/>
                        </placeholder>
                    </ListView>
                </TitledPane>
                <TitledPane animated="false" collapsible="false" prefHeight="260.0" text="Defeated / Forfeit Status"
                            HBox.hgrow="ALWAYS">
                    <ListView prefHeight="230.0" prefWidth="420.0">
                        <placeholder>
                            <Label text="Defeated/Forfeit players"/>
                        </placeholder>
                    </ListView>
                </TitledPane>
            </HBox>
            <TitledPane animated="false" collapsible="false" styleClass="section-panel" text="Final Result">
                <TextArea editable="false"
                          focusTraversable="false"
                          prefHeight="110.0"
                              promptText="Final Result"
                              styleClass="status-area"
                              wrapText="true"/>
            </TitledPane>
            <Label styleClass="menu-note" text="Gameplay has terminated. Further game actions are rejected after the final result is declared." wrapText="true">
                <font>
                    <Font size="13.0"/>
                </font>
            </Label>
        </VBox>
    </center>
</BorderPane>
