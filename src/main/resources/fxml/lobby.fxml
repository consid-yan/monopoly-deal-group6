<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ListView?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane prefHeight="640.0" prefWidth="960.0"
           styleClass="lobby-screen-root"
           xmlns="http://javafx.com/javafx/25.0.2"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ie.ucd.bdic.group6.ui.LobbyUI">
    <StackPane mouseTransparent="true" styleClass="menu-bg-pattern"/>
    <Label mouseTransparent="true" styleClass="menu-card-suit" text="&#9670;" StackPane.alignment="TOP_LEFT">
        <StackPane.margin>
            <Insets left="-10.0" top="-24.0"/>
        </StackPane.margin>
    </Label>
    <Label mouseTransparent="true" rotate="180.0" styleClass="menu-card-suit" text="&#9670;" StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets bottom="-24.0" right="-10.0"/>
        </StackPane.margin>
    </Label>

    <VBox alignment="CENTER" maxWidth="920.0" spacing="18.0" styleClass="lobby-content">
        <VBox alignment="CENTER" spacing="8.0" styleClass="lobby-brand">
            <Label styleClass="lobby-logo-title" text="Game Lobby" textAlignment="CENTER">
                <font>
                    <Font name="Georgia Bold" size="54.0"/>
                </font>
            </Label>
            <Label styleClass="lobby-logo-subtitle" text="Requires 2–5 players to start" textAlignment="CENTER">
                <font>
                    <Font size="12.0"/>
                </font>
            </Label>
        </VBox>

        <VBox alignment="CENTER" maxWidth="860.0" prefWidth="860.0" styleClass="lobby-panel">
            <HBox alignment="CENTER" maxWidth="720.0" prefWidth="720.0" spacing="10.0" styleClass="divider-ornament">
                <VBox.margin>
                    <Insets bottom="18.0"/>
                </VBox.margin>
                <Separator styleClass="divider-line" HBox.hgrow="ALWAYS"/>
                <Label styleClass="divider-symbol" text="&#9670;"/>
                <Separator styleClass="divider-line" HBox.hgrow="ALWAYS"/>
            </HBox>

            <HBox alignment="TOP_CENTER" maxWidth="760.0" prefWidth="760.0" spacing="24.0">
                <VBox spacing="14.0" HBox.hgrow="ALWAYS">
                    <Label styleClass="lobby-section-title" text="Room Information">
                        <font>
                            <Font name="System Bold" size="15.0"/>
                        </font>
                    </Label>
                    <GridPane hgap="12.0" styleClass="lobby-info-grid" vgap="12.0">
                        <columnConstraints>
                            <ColumnConstraints minWidth="120.0" prefWidth="132.0"/>
                            <ColumnConstraints hgrow="ALWAYS" minWidth="220.0"/>
                        </columnConstraints>
                        <Label styleClass="lobby-field-label" text="Room Code" GridPane.columnIndex="0" GridPane.rowIndex="0"/>
                        <Label fx:id="roomCodeLabel" maxWidth="Infinity" styleClass="lobby-readonly-label" text="Waiting for room code" GridPane.columnIndex="1" GridPane.rowIndex="0"/>
                        <Label styleClass="lobby-field-label" text="Host IP" GridPane.columnIndex="0" GridPane.rowIndex="1"/>
                        <Label fx:id="joinHostLabel" maxWidth="Infinity" styleClass="lobby-readonly-label" text="Waiting for host address" GridPane.columnIndex="1" GridPane.rowIndex="1"/>
                        <Label styleClass="lobby-field-label" text="Host" GridPane.columnIndex="0" GridPane.rowIndex="2"/>
                        <Label fx:id="hostLabel" maxWidth="Infinity" styleClass="lobby-readonly-label" text="Waiting for host" GridPane.columnIndex="1" GridPane.rowIndex="2"/>
                        <Label styleClass="lobby-field-label" text="Players Joined" GridPane.columnIndex="0" GridPane.rowIndex="3"/>
                        <Label fx:id="playerCountLabel" maxWidth="Infinity" styleClass="lobby-readonly-label" text="0 / 5" GridPane.columnIndex="1" GridPane.rowIndex="3"/>
                    </GridPane>

                    <Separator/>
                    <Label styleClass="lobby-section-title" text="Connected Players">
                        <font>
                            <Font name="System Bold" size="15.0"/>
                        </font>
                    </Label>
                    <ListView fx:id="playersList" focusTraversable="false" prefHeight="220.0" prefWidth="456.0" styleClass="readonly-list" VBox.vgrow="ALWAYS">
                        <placeholder>
                            <Label text="Waiting for players to join"/>
                        </placeholder>
                    </ListView>
                </VBox>

                <VBox alignment="TOP_CENTER" prefWidth="260.0" spacing="12.0">
                    <Button fx:id="startGameButton" graphicTextGap="10.0" mnemonicParsing="false" onAction="#startGame" prefHeight="44.0" prefWidth="260.0" styleClass="menu-primary-button" text="Start Game">
                        <VBox.margin>
                            <Insets top="32.0"/>
                        </VBox.margin>
                        <graphic>
                            <FontIcon iconLiteral="bx-play" styleClass="menu-icon-primary"/>
                        </graphic>
                    </Button>
                    <Button graphicTextGap="10.0" mnemonicParsing="false" onAction="#openHowToPlay" prefHeight="44.0" prefWidth="260.0" styleClass="menu-secondary-button" text="How to Play">
                        <graphic>
                            <FontIcon iconLiteral="bx-question-mark" styleClass="menu-icon-secondary"/>
                        </graphic>
                    </Button>
                    <Button graphicTextGap="10.0" mnemonicParsing="false" onAction="#leaveLobby" prefHeight="44.0" prefWidth="260.0" styleClass="menu-danger-button" text="Leave Lobby">
                        <graphic>
                            <FontIcon iconLiteral="bx-exit" styleClass="menu-icon-danger"/>
                        </graphic>
                    </Button>

                    <Separator prefWidth="260.0"/>

                    <Label styleClass="lobby-section-title" text="Status">
                        <font>
                            <Font name="System Bold" size="15.0"/>
                        </font>
                        <VBox.margin>
                            <Insets top="24.0"/>
                        </VBox.margin>
                    </Label>

                    <TextArea fx:id="statusArea"
                              editable="false"
                              focusTraversable="false"
                              prefHeight="134.0"
                              prefWidth="260.0"
                              promptText="Lobby messages and validation feedback will appear here."
                              styleClass="lobby-status-area"
                              wrapText="true">
                        <VBox.margin>
                            <Insets top="8.0"/>
                        </VBox.margin>
                    </TextArea>
                </VBox>
            </HBox>
        </VBox>
    </VBox>
</StackPane>
