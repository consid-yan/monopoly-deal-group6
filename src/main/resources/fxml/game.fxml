<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.Separator?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.ColumnConstraints?>
<?import javafx.scene.layout.FlowPane?>
<?import javafx.scene.layout.GridPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.StackPane?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.text.Font?>
<?import org.kordamp.ikonli.javafx.FontIcon?>

<StackPane styleClass="game-screen-root"
           xmlns="http://javafx.com/javafx/25.0.2"
           xmlns:fx="http://javafx.com/fxml/1"
           fx:controller="ie.ucd.bdic.group6.ui.GameUI">
    <StackPane mouseTransparent="true" styleClass="menu-bg-pattern"/>
    <Label mouseTransparent="true" styleClass="menu-card-suit" text="&#9670;" StackPane.alignment="TOP_LEFT">
        <StackPane.margin>
            <Insets left="-10.0" top="-24.0"/>
        </StackPane.margin>
    </Label>
    <Label mouseTransparent="true" rotate="180.0" styleClass="menu-card-suit" text="&#9670;" StackPane.alignment="BOTTOM_RIGHT">
        <StackPane.margin>
            <Insets bottom="-24.0" right="-10.0"/>
        </StackPane.margin>
    </Label>

    <BorderPane styleClass="game-shell" StackPane.alignment="CENTER">
        <top>
            <VBox spacing="10.0" styleClass="game-header" BorderPane.alignment="CENTER">
                <padding>
                    <Insets bottom="10.0" left="28.0" right="28.0" top="20.0"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="16.0">
                    <VBox spacing="1.0" HBox.hgrow="ALWAYS">
                        <Label styleClass="game-logo-title" text="Monopoly Deal">
                            <font>
                                <Font name="Georgia Bold" size="36.0"/>
                            </font>
                        </Label>
                    </VBox>
                    <HBox alignment="CENTER_RIGHT" spacing="8.0">
                        <Button graphicTextGap="8.0" mnemonicParsing="false" onAction="#openHowToPlay" prefHeight="36.0" prefWidth="106.0" styleClass="menu-outline-button game-nav-button" text="Rules">
                            <graphic>
                                <FontIcon iconLiteral="bx-question-mark" styleClass="menu-icon-outline"/>
                            </graphic>
                        </Button>
                    </HBox>
                </HBox>

                <GridPane hgap="8.0" styleClass="game-status-strip" vgap="6.0">
                    <columnConstraints>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="19.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="18.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="21.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="18.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="12.0"/>
                        <ColumnConstraints hgrow="ALWAYS" percentWidth="12.0"/>
                    </columnConstraints>
                    <VBox spacing="3.0" styleClass="game-stat-chip" GridPane.columnIndex="0" GridPane.rowIndex="0">
                        <Label styleClass="game-stat-label" text="Active Player"/>
                        <TextField fx:id="activePlayerField" editable="false" focusTraversable="false" promptText="Waiting" styleClass="game-stat-value"/>
                    </VBox>
                    <VBox spacing="3.0" styleClass="game-stat-chip" GridPane.columnIndex="1" GridPane.rowIndex="0">
                        <Label styleClass="game-stat-label" text="Turn"/>
                        <TextField fx:id="turnStatusField" editable="false" focusTraversable="false" promptText="Actions" styleClass="game-stat-value"/>
                    </VBox>
                    <VBox spacing="3.0" styleClass="game-stat-chip" GridPane.columnIndex="2" GridPane.rowIndex="0">
                        <Label styleClass="game-stat-label" text="You"/>
                        <TextField fx:id="identityField" editable="false" focusTraversable="false" promptText="Player" styleClass="game-stat-value"/>
                    </VBox>
                    <VBox spacing="3.0" styleClass="game-stat-chip" GridPane.columnIndex="3" GridPane.rowIndex="0">
                        <Label styleClass="game-stat-label" text="Room Code"/>
                        <TextField fx:id="roomCodeField" editable="false" focusTraversable="false" promptText="Room code" styleClass="game-stat-value"/>
                    </VBox>
                    <VBox spacing="3.0" styleClass="game-stat-chip" GridPane.columnIndex="4" GridPane.rowIndex="0">
                        <Label styleClass="game-stat-label" text="Deck"/>
                        <Label fx:id="deckSummaryLabel" styleClass="game-stat-readout" text="0 cards"/>
                    </VBox>
                    <VBox spacing="3.0" styleClass="game-stat-chip" GridPane.columnIndex="5" GridPane.rowIndex="0">
                        <Label styleClass="game-stat-label" text="Discard"/>
                        <Label fx:id="discardPileSummaryLabel" styleClass="game-stat-readout" text="0 cards"/>
                    </VBox>
                </GridPane>
            </VBox>
        </top>

        <center>
            <VBox spacing="10.0" styleClass="game-center" BorderPane.alignment="CENTER">
                <padding>
                    <Insets bottom="8.0" left="24.0" right="14.0"/>
                </padding>

                <VBox spacing="6.0" styleClass="game-opponents-band">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label styleClass="game-section-title" text="Opponents"/>
                    </HBox>
                    <ScrollPane fitToWidth="true" minHeight="100.0" prefHeight="130.0" styleClass="game-opponent-scroll"
                                vbarPolicy="NEVER">
                        <HBox fx:id="opponentsRow" alignment="CENTER_LEFT" minHeight="100.0" spacing="10.0"
                              styleClass="opponents-row"/>
                    </ScrollPane>
                </VBox>

                <VBox spacing="10.0" styleClass="game-main-table clean-game-main-table" VBox.vgrow="ALWAYS">
                    <HBox alignment="CENTER_LEFT" spacing="10.0">
                        <Label styleClass="game-section-title" text="Your Table"/>
                        <Label styleClass="game-helper-text" text="End your turn with 3 complete property sets to win"/>
                    </HBox>

                    <VBox spacing="5.0" styleClass="game-board-row clean-game-board-row game-zone-panel clean-zone-panel"
                          minHeight="160.0" prefHeight="160.0" maxHeight="160.0">
                        <Label styleClass="zone-heading" text="Bank"/>
                        <ScrollPane fx:id="bankScrollPane" fitToHeight="true"
                                    minHeight="130.0" prefHeight="130.0" maxHeight="130.0" styleClass="game-bank-scroll"
                                    vbarPolicy="NEVER">
                            <HBox fx:id="bankZone" minHeight="118.0" prefHeight="118.0"
                                  spacing="7.0"
                                  styleClass="drop-zone symbolic-drop-zone bank-drop-zone game-drop-zone clean-drop-zone"/>
                        </ScrollPane>
                    </VBox>

                    <VBox spacing="6.0" styleClass="game-zone-panel clean-property-panel" minHeight="0.0" VBox.vgrow="ALWAYS">
                        <HBox alignment="CENTER_LEFT" spacing="10.0">
                            <Label styleClass="zone-heading" text="Properties"/>
                        </HBox>
                        <ScrollPane fx:id="propertyRowsScroll" fitToWidth="true" hbarPolicy="NEVER"
                                    minHeight="0.0" styleClass="game-property-scroll" VBox.vgrow="ALWAYS">
                            <FlowPane fx:id="propertyRowsZone" hgap="10.0" minHeight="150.0" styleClass="property-board clean-property-rows" vgap="10.0">
                                <padding>
                                    <Insets bottom="2.0" left="2.0" right="2.0" top="2.0"/>
                                </padding>
                            </FlowPane>
                        </ScrollPane>
                    </VBox>
                </VBox>
            </VBox>
        </center>

        <right>
            <VBox maxHeight="365.0" prefWidth="270.0" spacing="10.0" styleClass="game-action-rail" BorderPane.alignment="CENTER">
                <BorderPane.margin>
                    <Insets top="35.0"/>
                </BorderPane.margin>

                <padding>
                    <Insets bottom="10.0" left="8.0" right="24.0"/>
                </padding>

                <Label styleClass="game-section-title" text="Turn Actions"/>

                <Button fx:id="endTurnButton" graphicTextGap="8.0" mnemonicParsing="false" onAction="#endTurn"
                        prefHeight="38.0" prefWidth="238.0"
                        styleClass="menu-outline-button game-command-button"
                        text="End Turn">
                    <graphic>
                        <FontIcon iconLiteral="bx-skip-next" styleClass="menu-icon-outline"/>
                    </graphic>
                </Button>

                <Separator prefWidth="238.0"/>

                <Label styleClass="game-section-title" text="Trade"/>

                <Button fx:id="proposeTradeButton" graphicTextGap="6.0" mnemonicParsing="false" onAction="#proposeTrade"
                        prefHeight="38.0" prefWidth="238.0"
                        styleClass="menu-primary-button game-command-button"
                        text="Propose Trade">
                    <graphic>
                        <FontIcon iconLiteral="bx-log-in-circle" styleClass="menu-icon-primary"/>
                    </graphic>
                </Button>

                <Separator prefWidth="238.0"/>

                <Label styleClass="game-section-title" text="Activity"/>

                <TextArea fx:id="gameActivityArea" editable="false" focusTraversable="false" prefHeight="116.0"
                          promptText="Current game status"
                          styleClass="status-area game-activity-area"
                          wrapText="true"/>
            </VBox>
        </right>

        <bottom>
            <VBox spacing="7.0" styleClass="hand-panel game-hand-panel" BorderPane.alignment="CENTER">
                <padding>
                    <Insets bottom="16.0" left="28.0" right="28.0" top="4.0"/>
                </padding>
                <HBox alignment="CENTER_LEFT" spacing="12.0">
                    <Label styleClass="game-section-title" text="Your Hand"/>
                    <Label fx:id="selectedCardSummaryLabel" maxWidth="720.0" styleClass="game-selected-card-summary" text="Select a card to see available actions." wrapText="true" HBox.hgrow="ALWAYS"/>
                </HBox>
                <ScrollPane fx:id="handScrollPane" fitToHeight="true" fitToWidth="true" minHeight="150.0" prefHeight="170.0" styleClass="hand-scroll-pane" vbarPolicy="NEVER">
                    <HBox fx:id="handCardsHBox" alignment="CENTER" minHeight="130.0" spacing="8.0" styleClass="hand-cards-box">
                        <padding>
                            <Insets bottom="4.0" left="4.0" right="4.0" top="20.0"/>
                        </padding>
                    </HBox>
                </ScrollPane>
            </VBox>
        </bottom>
    </BorderPane>
</StackPane>
